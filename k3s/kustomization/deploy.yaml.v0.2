apiVersion: apps/v1
kind: Deployment
metadata:
  name: dknotes-web
  labels:
    app: dknotes
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dknotes
  template:
    metadata:
      labels:
        app: dknotes
    spec:
      containers:
      # ----------------------------------------------------
      # CONTENEDOR 1: Nginx (El servidor Web)
      # ----------------------------------------------------
      - name: nginx
        image: nginx:alpine
        ports:
        - containerPort: 80
          name: http
        volumeMounts:
        # Comparte el código fuente con Laravel para servir estáticos
        - name: code-volume
          mountPath: /var/www/html/public
        # Inyecta el archivo default.conf que modificamos
        - name: nginx-config-volume
          mountPath: /etc/nginx/conf.d/default.conf
          subPath: default.conf

      # ----------------------------------------------------
      # CONTENEDOR 2: Tu App Laravel (PHP-FPM)
      # ----------------------------------------------------
      - name: web-app
        image: 10.0.0.100:5000/dknotes-laravel:v1
        imagePullPolicy: Always
        ports:
        - containerPort: 9000
          name: fastcgi
        env:
        - name: DB_HOST
          value: "postgres-service.postgres.svc.cluster.local"
        - name: POSTGRES_DB
          value: "dknotes"
        - name: POSTGRES_USER
          valueFrom:
            secretKeyRef:
              name: dknotes-secrets
              key: username
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: dknotes-secrets
              key: password
        resources:
          limits:
            cpu: "1000m"
            memory: "1Gi"
          requests:
            cpu: "400m"
            memory: "512Mi"
        volumeMounts:
        # Monta el volumen compartido del código
        - name: code-volume
          mountPath: /var/www/html
        # CORRECCIÓN: El almacenamiento persistente (NFS) va en la carpeta de uploads
        - name: storage-uploads
          mountPath: /var/www/html/storage/app/public

      # ----------------------------------------------------
      # VOLÚMENES DEL POD
      # ----------------------------------------------------
      volumes:
      # Volumen temporal compartido entre Nginx y Laravel
      - name: code-volume
        emptyDir: {}
      # Carga la configuración de Nginx desde el ConfigMap de Kustomize
      - name: nginx-config-volume
        configMap:
          name: nginx-config
      # Tu almacenamiento persistente NFS real para imágenes/archivos
      - name: storage-uploads
        persistentVolumeClaim:
          claimName: dknotes-uploads-pvc
