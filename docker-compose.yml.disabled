services:
  # El Motor de Base de Datos
  postgres:
    build:
      context: ./postgres
    container_name: dk-db
    restart: always
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres  # ← cambia esto
      POSTGRES_DB: postgres  # o el nombre que uses
#    ports:
#      - "5432:5432"
      POSTGRES_DB: dk_notes
      POSTGRES_USER: dk_user
    security_opt:
      - label:disable
    userns_mode: "keep-id"
    volumes:
      - /var/home/datenmaniak/pg-data:/var/lib/postgresql/data
    networks:
      - dk-network
    ports:
       - "5432:5432"

  # El Procesador de PHP (Laravel)
  laravel:
    build:
      context: ./laravel
    container_name: dk-app
    restart: always
    security_opt:
      - label:disable
    userns_mode: "keep-id"
    volumes:
      - ./app:/var/www:Z
    networks:
      - dk-network
    ports:
       - "9000:9000"
    depends_on:
      - postgres

  # El Servidor Web (Nginx)
  nginx:
    build:
      context: ./nginx
    container_name: dk-proxy
    restart: always
    ports:
      - "8080:80"
    volumes:
      - ./app:/var/www/notes:Z
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:Z
    networks:
      - dk-network
    depends_on:
      - laravel

networks:
  dk-network:
    external: true
    name: dk-network

volumes:
  dk-db-data:
